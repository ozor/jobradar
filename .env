# Только dev-дефолты для локальной разработки, не секреты.
# Переопределения: переменные окружения shell или compose.override.yaml
# (Compose 2.15 сам .env.local не читает).
# Переменные Symfony (APP_ENV, APP_SECRET и т. п.) добавятся сюда после установки Symfony.

HOST_UID=1000
HOST_GID=1000

NGINX_PORT=28080

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_PORT=25432
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?serverVersion=17&charset=utf8"

REDIS_PORT=26379
REDIS_URL="redis://redis:6379"

RABBITMQ_DEFAULT_USER=app
RABBITMQ_DEFAULT_PASS=app
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_PORT=25673
RABBITMQ_MANAGEMENT_PORT=25674
MESSENGER_TRANSPORT_DSN="amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672/%2f/messages"

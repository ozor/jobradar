# strict-rules, symfony and doctrine extensions are included automatically
# by phpstan/extension-installer. No baseline, no inline ignores: fix the code.
parameters:
    level: max
    paths:
        - src
        - tests
    excludePaths:
        - tests/bootstrap.php
    tmpDir: var/cache/phpstan
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/object-manager.php
